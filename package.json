{
  "name": "volley-web-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "homepage": "https://thaydds.github.io/volley-web-app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.backend.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:release": "node --test tools/release/*.test.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@beachsports/components": "0.8.0",
    "@beachsports/tokens": "0.1.1",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-window": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.9"
  }
}
